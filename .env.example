# =============================================
# CONFIGURAÇÃO DO DISCORD AUTOPING
# =============================================
# Copie este arquivo para .env e preencha os valores

# Token da sua conta Discord (OBRIGATÓRIO)
# Como obter: Pressione F12 no Discord Web/App > Console > cole:
# (webpackChunkdiscord_app.push([[''],{},e=>{m=[];for(let c in e.c)m.push(e.c[c])}]),m).find(m=>m?.exports?.default?.getToken!==void 0).exports.default.getToken()
DISCORD_TOKEN=seu_token_aqui

# ID do canal que será monitorado para novos tópicos (OBRIGATÓRIO)
# Como obter: Ative o Modo Desenvolvedor nas configurações do Discord
# Depois clique com botão direito no canal > Copiar ID
CHANNEL_ID=123456789012345678

# Mensagem que será enviada quando um novo tópico for criado
# Você pode modificar para qualquer mensagem que desejar
AUTO_MESSAGE=Olá! Tenho interesse em participar!

# A resposta é enviada logo após a 1ª mensagem do criador do tópico
# (assim ela sempre aparece DEPOIS do post inicial).
# Tempo máximo (ms) aguardando essa mensagem; se não vier, envia mesmo assim.
# Padrão: 5000
WAIT_FOR_MESSAGE=5000

# Delay humanizado (ms) após a 1ª mensagem do criador, para o tempo de
# resposta parecer humano. Padrão: 900 | 0 = mais rápido possível
HUMANIZED_DELAY=900

# Sleep após responder: true = depois de responder um tópico o AutoPing
# desliga sozinho e só volta com "!autoPing on". Padrão: false
SLEEP_AFTER_REPLY=false

# (Opcional) Build number do cliente web do Discord usado na identificação.
# Só altere se souber o valor atual. Padrão definido em src/discord/properties.js
# CLIENT_BUILD_NUMBER=
